{
  "name": "wexample/symfony-notification",
  "description": "Notifications addressed to people: a catalogue of types, an inbox, each person's choice of channel, and once per window for reminders — sent by mail, chat or webhook",
  "version": "2.1.2",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyNotification\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyNotification\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "doctrine/orm": "^3.0",
    "doctrine/doctrine-bundle": "^2.13 || ^3.0",
    "symfony/http-client": "^7.4 || ^8.0",
    "symfony/http-kernel": "^7.4 || ^8.0",
    "symfony/messenger": "^7.4 || ^8.0",
    "symfony/notifier": "^7.4 || ^8.0",
    "symfony/routing": "^7.4 || ^8.0",
    "symfony/security-core": "^7.4 || ^8.0",
    "symfony/uid": "^7.4 || ^8.0",
    "wexample/symfony-helpers": ">=17.0.0",
    "wexample/symfony-loader": ">=23.3.0",
    "wexample/symfony-mail": ">=3.0.0",
    "wexample/symfony-translations": ">=15.0.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13",
    "wexample/symfony-testing": ">=2.0.0",
    "symfony/browser-kit": "^7.4 || ^8.0",
    "symfony/security-bundle": "^7.4 || ^8.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}